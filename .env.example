# ============================================================
# Environment Configuration — Text Summarization System
# ============================================================
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ============================================================

# Application environment: development | staging | production
APP_ENV=development

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Model paths (relative to project root or absolute)
MODEL_PATH=artifacts/model_trainer/pegasus-samsum-model
TOKENIZER_PATH=artifacts/model_trainer/tokenizer

# Fallback HuggingFace model hub identifier (used when local artifacts are absent)
HF_MODEL_ID=google/pegasus-cnn_dailymail

# Data paths
DATA_PATH=artifacts/data_ingestion/samsum_dataset

# Inference configuration
MAX_INPUT_LENGTH=1024
MAX_SUMMARY_LENGTH=128
NUM_BEAMS=2
LENGTH_PENALTY=0.8

# CORS origins (comma-separated, for production API hardening)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
